# ==============================================================================
# Dockerfile.api: Backend API Container cho AI Whiteboard Video Studio
# Python 3.11-slim + FFmpeg + OpenCV Headless + PyAV + Hardware Acceleration
# ==============================================================================

FROM python:3.11-slim AS base

# Ngăn python sinh file .pyc và bật stdout buffer flushing ngay lập tức
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Cài đặt các gói hệ thống cần thiết: FFmpeg, build tools, font chữ Tiếng Việt
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    build-essential \
    fonts-noto \
    fonts-liberation \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Cài đặt Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Sao chép mã nguồn backend
COPY core/ ./core/
COPY engines/ ./engines/
COPY scripts/ ./scripts/
COPY apps/api/ ./apps/api/
COPY assets/ ./assets/

# Tạo thư mục output và cấp quyền
RUN mkdir -p /app/output && chmod -R 777 /app/output

# Cấu hình biến môi trường mặc định
ENV HOST=0.0.0.0 \
    PORT=8000 \
    APP_ENV=production \
    IMAGE_GENERATOR_PROVIDER=pollinations \
    REDIS_URL=redis://redis:6379/0

EXPOSE 8000

# Healthcheck endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Khởi chạy FastAPI Server bằng Uvicorn
CMD ["python", "-m", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
