# ==============================================================
# AI Whiteboard Video Production Studio - Environment Variables
# ==============================================================
# SAU KHI SAO CHÉP THÀNH .env, ĐIỀN CÁC GIÁ TRỊ TƯƠNG ỨNG.
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env LÊN GIT REPOSITORY.

# Application Configuration
APP_NAME="AI Whiteboard Video Production Studio API"
APP_ENV="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (comma separated)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Providers (Để trống khi dùng Mock Provider trong quá trình phát triển)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
# Hugging Face Free Token cho Cloud FLUX Line-Art (tùy chọn - nhận miễn phí tại https://huggingface.co/settings/tokens)
HF_TOKEN=""

# Storage Configuration
STORAGE_TYPE="local" # local | memory | s3
STORAGE_BASE_DIR="./out/storage"

